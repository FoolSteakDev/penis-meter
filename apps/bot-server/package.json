{
  "name": "bot-server",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsoa spec-and-routes && tsx watch src/index.ts",
    "dev:apionly": "tsoa spec-and-routes && tsx watch src/dev-api-only.ts",
    "build": "tsoa spec-and-routes && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/database/seed.ts",
    "backfill:rounds": "tsx src/database/backfill-legacy-rounds.ts",
    "backfill:mode-sign": "tsx src/database/backfill-mode-value-sign.ts",
    "duel:stats": "tsx src/scripts/duel-stats.ts",
    "typecheck": "tsoa spec-and-routes && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "node-cron": "^4.6.0",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.10",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
